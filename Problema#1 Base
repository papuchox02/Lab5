
import numpy as np
from time import perf_counter

# ==================================================
# LABORATORIO 5 - PROBLEMA 1
# ESTRUCTURA EN EQUILIBRIO
# METODO DE ELIMINACION DE GAUSS
# ==================================================

# 1. DATOS DEL PROBLEMA
angulos = np.radians([0, 45, 120])

# Matriz original del PDF: 2 ecuaciones, 3 incognitas
A_original = np.array([
    np.cos(angulos),
    np.sin(angulos)
])

b_original = np.zeros(2)

print("=== SISTEMA ORIGINAL ===")
print("Matriz A:")
print(A_original)
print("Vector b:", b_original)
print("Dimension:", A_original.shape)

print("\nEl sistema tiene 2 ecuaciones y 3 incognitas.")
print("Se necesita un dato adicional para obtener")
print("una solucion numerica unica.")

# 2. FIJAR UNA FUERZA COMO DATO ADICIONAL
F3 = 100.0  # N, valor supuesto para el laboratorio

# A*x = b, con x = [F1, F2]
A = A_original[:, :2]
b = -A_original[:, 2] * F3

print("\n=== SISTEMA REDUCIDO ===")
print("F3 =", F3, "N")
print("Matriz A:")
print(A)
print("Vector b:")
print(b)


# 3. ELIMINACION DE GAUSS
def eliminacion_gauss(A, b):
    A = A.astype(float).copy()
    b = b.astype(float).copy()

    n = len(b)

    # Eliminacion hacia adelante
    for k in range(n - 1):

        # Pivoteo parcial
        fila_pivote = k + np.argmax(abs(A[k:, k]))

        if abs(A[fila_pivote, k]) < 1e-12:
            raise ValueError("Sistema singular")

        A[[k, fila_pivote]] = A[[fila_pivote, k]]
        b[[k, fila_pivote]] = b[[fila_pivote, k]]

        for i in range(k + 1, n):
            factor = A[i, k] / A[k, k]

            A[i, k:] -= factor * A[k, k:]
            b[i] -= factor * b[k]

    # Sustitucion hacia atras
    x = np.zeros(n)

    for i in range(n - 1, -1, -1):
        if abs(A[i, i]) < 1e-12:
            raise ValueError("Sistema singular")

        suma = np.dot(A[i, i+1:], x[i+1:])
        x[i] = (b[i] - suma) / A[i, i]

    return x


# 4. RESOLVER POR GAUSS
inicio = perf_counter()
solucion_gauss = eliminacion_gauss(A, b)
tiempo_gauss = perf_counter() - inicio

# 5. VERIFICAR CON NUMPY
inicio = perf_counter()
solucion_numpy = np.linalg.solve(A, b)
tiempo_numpy = perf_counter() - inicio

# 6. CALCULAR ERRORES
error = np.linalg.norm(
    solucion_gauss - solucion_numpy
)

residuo = np.linalg.norm(
    A @ solucion_gauss - b
)

F1, F2 = solucion_gauss

# 7. MOSTRAR RESULTADOS
print("\n=== RESULTADOS ===")
print(f"F1 = {F1:.6f} N")
print(f"F2 = {F2:.6f} N")
print(f"F3 = {F3:.6f} N")

print("\n=== COMPARACION ===")
print("Solucion Gauss:", solucion_gauss)
print("Solucion NumPy:", solucion_numpy)
print(f"Error entre metodos: {error:.6e}")
print(f"Residuo del sistema: {residuo:.6e}")

print("\n=== TIEMPOS ===")
print(f"Gauss: {tiempo_gauss:.6e} s")
print(f"NumPy: {tiempo_numpy:.6e} s")

# 8. COMPROBACION DEL EQUILIBRIO
fuerzas = np.array([F1, F2, F3])
equilibrio = A_original @ fuerzas

print("\n=== VERIFICACION FISICA ===")
print(f"Suma de fuerzas en X: {equilibrio[0]:.6e} N")
print(f"Suma de fuerzas en Y: {equilibrio[1]:.6e} N")
